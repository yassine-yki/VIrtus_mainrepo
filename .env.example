# All values are server-only. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct or session-pooler connection for the one-time migration command.
DATABASE_URL=
# There is one public catalog. Source switches in Supabase control visibility.
# Enable only after public production smoke tests pass. Preview always stays noindex.
PUBLIC_INDEXING_ENABLED=false
# Use only for local review of a collected snapshot; ignored in production.
LOCAL_CATALOG_PATH=data/catalog.json
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default is true; use false to disable all scheduled collection.
COLLECTION_ENABLED=true
# Private candidate pilot; keep disabled until password authentication is verified.
CANDIDATE_PROFILES_ENABLED=false
# Enable only after Supabase email/password signup works with Confirm email OFF.
# No magic links or confirmation messages are sent by the candidate UI.
CANDIDATE_PASSWORD_AUTH_READY=false
CV_EXTRACTION_ENABLED=false
# Full HTTPS chat/completions URL, explicit model/provider; no automatic provider routing.
HF_ENDPOINT=
HF_MODEL=
HF_TOKEN=
HF_INPUT_USD_PER_MILLION=
HF_OUTPUT_USD_PER_MILLION=
HF_PRICING_VERSION=
HF_PRIVACY_REVIEWED=false
HF_PRIVACY_URL=
